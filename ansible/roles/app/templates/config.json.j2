{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8848,
      "https": false
    }
  ],
  "db_clients": [
    {
      "name": "default",
      "rdbms": "postgresql",
      "host": "drogon-postgres.dns.podman",
      "port": 5432,
      "dbname": "{{ vote_backend_db_name }}",
      "user": "{{ vote_backend_db_user }}",
      "passwd": "{{ vote_backend_db_password }}",
      "is_fast": false,
      "number_of_connections": 1,
      "timeout": -1.0,
      "auto_batch": false
    }
  ],
  "app": {
    "document_root": "/static",
    "log": {
      "log_path": "",
      "use_spdlog": true,
      "logfile_base_name": "",
      "log_size_limit": 100000000,
      "max_files": 0,
      "log_level": "DEBUG",
      "display_local_time": false
    }
  },
  "jwt_secret": "{{ vote_backend_jwt_secret_key }}",
  "jwt_access_token_expiry_minutes": 15,
  "jwt_refresh_token_expiry_days": 7,
  "resend_api_url": "{{ vote_backend_resend_api_url | default('https://api.resend.com') }}",
  "resend_api_key": "{{ vote_backend_resend_api_key | default('') }}",
  "resend_from_email": "{{ vote_backend_resend_from_email | default('onboarding@resend.dev') }}",
  "app_reset_url": "{{ vote_backend_app_reset_url | default('https://vote-backend.local/reset-password') }}",
  "password_reset_token_expiry_hours": {{ vote_backend_password_reset_token_expiry_hours | default(1) }},
  "password_reset_max_attempts": {{ vote_backend_password_reset_max_attempts | default(5) }},
  "password_reset_rate_limit_window_minutes": {{ vote_backend_password_reset_rate_limit_window_minutes | default(15) }},
  "password_reset_rate_limit_max_requests": {{ vote_backend_password_reset_rate_limit_max_requests | default(3) }},
  "allowed_origin": "{{ vote_backend_allowed_origin }}",
  "age_bucket_size": {{ vote_backend_age_bucket_size | default(10) }},
  "stats_min_answers": {{ vote_backend_stats_min_answers | default(5) }},
  "plugins": [
    {
      "name": "drogon::plugin::AccessLogger",
      "dependencies": [],
      "config": {
        "log_path": "",
        "log_format": "",
        "log_index": 0,
        "use_spdlog": true
      }
    }
  ]
}
