# containers/drogon-postgres.container
# Podman quadlet definition for the PostgreSQL database.
# Rendered by the postgres role from this template.
#
# When `vote_backend_postgres_persistent` is true the PostgreSQL data directory
# is bind-mounted from {{ vote_backend_postgres_data_dir }} so that the database
# survives container restarts. Otherwise the database is ephemeral (the data
# lives only inside the container and is reset on every (re)deploy).
#
# PostgreSQL >= 18 requires the major version ("18") to appear in the data
# directory path (see docker-library/postgres#1259). This applies to the
# in-container PGDATA, so PGDATA is set to /var/lib/postgresql/data/18 and the
# host bind-mount (when persistent) maps to that same path. Both therefore
# include "/18".
#
# Generated systemd unit: drogon-postgres.service

[Container]
ContainerName=drogon-postgres
Image=docker.io/library/postgres:18-trixie
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Environment=POSTGRES_DB={{ vote_backend_db_name }}
# Fixed bootstrap superuser name: it exists only to run the init scripts.
# Application/maintenance users and all grants are managed by a separate
# Ansible role, so this container knows nothing about them.
Environment=POSTGRES_USER=postgres
Environment=PGDATA=/var/lib/postgresql/data/18
# Sole credential inside this container: consumed by the image entrypoint
# during first initialization only. Mounted read-only under /run/secrets,
# invisible to `systemctl --user cat` and `podman inspect`.
Secret=vote_db_postgres_password,target=postgres-password
Volume=%h/.local/share/vote-backend/sql:/docker-entrypoint-initdb.d:Z
{% if vote_backend_postgres_persistent %}
Volume=%h/.local/share/vote-backend/postgres/18:/var/lib/postgresql/data/18:Z
{% endif %}
Network=vote.network

[Service]
Restart=on-failure
# Wait until PostgreSQL is truly ready to accept connections
# before signaling the service as started.
ExecStartPost=/bin/sh -c 'until podman exec drogon-postgres pg_isready -h localhost -p 5432 -U postgres; do sleep 1; done'

[Install]
